+    TEST_F(LuaStateTest, UnsafeStdlibBypassIsDisabledByDefault)
+    {
+        const sol::table script = mLua.runInNewSandbox(VFS::Path::Normalized(testsPath));
+
+        EXPECT_THROW(LuaUtil::call(script["sandboxBypassHasIo"]), std::runtime_error);
+    }
+
+    TEST_F(LuaStateTest, UnsafeStdlibBypassRequiresOptInAndPreservesSelect)
+    {
+        LuaUtil::LuaStateSettings settings;
+        settings.mUnsafeStdlibAccess = true;
+        LuaUtil::LuaState lua(mVFS.get(), &mCfg, settings);
