 #include <fstream>
 
@@ -59,6 +60,108 @@ namespace LuaUtil
         "tonumber", "tostring", "type", "unpack", "xpcall", "rawequal", "rawget", "rawset", "setmetatable" };
     static const std::string safePackages[] = { "coroutine", "math", "string", "table", "utf8" };
 
+    namespace
+    {
+        constexpr char sandboxBypassName[] = "sandbox.bypass";
+
+        int absoluteIndex(lua_State* state, int index)
+        {
+            if (index > 0 || index <= LUA_REGISTRYINDEX)
+                return index;
+            return lua_gettop(state) + index + 1;
+        }
+
+        void setFieldFromGlobalIfPresent(lua_State* state, int tableIndex, const char* globalName)
+        {
+            tableIndex = absoluteIndex(state, tableIndex);
+            lua_getglobal(state, globalName);
+            if (lua_isnil(state, -1))
+                lua_pop(state, 1);
+            else
+                lua_setfield(state, tableIndex, globalName);
+        }
+
+        void setFfiFieldIfAvailable(lua_State* state, int tableIndex)
+        {
+            tableIndex = absoluteIndex(state, tableIndex);
+            lua_getglobal(state, "require");
+            if (!lua_isfunction(state, -1))
+            {
+                lua_pop(state, 1);
+                return;
+            }
+
+            lua_pushliteral(state, "ffi");
+            if (lua_pcall(state, 1, 1, 0) != 0)
+            {
+                lua_pop(state, 1);
+                return;
+            }
+
+            if (lua_isnil(state, -1))
+                lua_pop(state, 1);
+            else
+                lua_setfield(state, tableIndex, "ffi");
+        }
+
+        void pushSandboxBypassTable(lua_State* state)
+        {
+            lua_createtable(state, 0, 10);
+            const int tableIndex = absoluteIndex(state, -1);
+
+            setFieldFromGlobalIfPresent(state, tableIndex, "collectgarbage");
+            setFieldFromGlobalIfPresent(state, tableIndex, "require");
+            setFieldFromGlobalIfPresent(state, tableIndex, "package");
+            setFieldFromGlobalIfPresent(state, tableIndex, "io");
+            setFieldFromGlobalIfPresent(state, tableIndex, "os");
+            setFieldFromGlobalIfPresent(state, tableIndex, "debug");
+            setFieldFromGlobalIfPresent(state, tableIndex, "bit");
+            setFieldFromGlobalIfPresent(state, tableIndex, "bit32");
+            setFieldFromGlobalIfPresent(state, tableIndex, "jit");
+            setFfiFieldIfAvailable(state, tableIndex);
+        }
+
+        bool isSandboxBypassRequest(lua_State* state)
+        {
+            size_t length = 0;
+            const char* value = lua_tolstring(state, 1, &length);
+            return value != nullptr && length == sizeof(sandboxBypassName) - 1
+                && std::memcmp(value, sandboxBypassName, sizeof(sandboxBypassName) - 1) == 0;
+        }
+
+        int sandboxBypassSelect(lua_State* state)
+        {
+            const int arguments = lua_gettop(state);
+            if (arguments == 1 && lua_type(state, 1) == LUA_TSTRING && isSandboxBypassRequest(state))
+            {
+                lua_pushvalue(state, lua_upvalueindex(2));
+                return 1;
+            }
+
+            lua_pushvalue(state, lua_upvalueindex(1));
+            lua_insert(state, 1);
+            lua_call(state, arguments, LUA_MULTRET);
+            return lua_gettop(state);
+        }
+
+        void installSandboxStdlibBypass(lua_State* state, bool enabled)
+        {
+            if (!enabled)
+                return;
+
+            lua_getglobal(state, "select");
+            if (!lua_isfunction(state, -1))
+            {
+                lua_pop(state, 1);
+                return;
+            }
+
+            pushSandboxBypassTable(state);
+            lua_pushcclosure(state, sandboxBypassSelect, 2);
+            lua_setglobal(state, "select");
+        }
+    }
