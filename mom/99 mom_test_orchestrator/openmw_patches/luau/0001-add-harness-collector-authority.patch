diff --git a/components/lua/luastate.cpp b/components/lua/luastate.cpp
index 2e897ce..9b10049 100644
--- a/components/lua/luastate.cpp
+++ b/components/lua/luastate.cpp
@@ -31,6 +31,100 @@ namespace Lua
 {
     namespace
     {
+        // Test-only VM authority. Luau intentionally has no public
+        // collectgarbage library; use the actual collector rather than a shim.
+        int harnessCollectGarbage(lua_State* state)
+        {
+            const std::string_view option(luaL_optstring(state, 1, "collect"));
+            if (option == "count")
+                lua_pushnumber(state, static_cast<double>(lua_totalbytes(state, -1)) / 1024.0);
+            else if (option == "isrunning")
+                lua_pushboolean(state, lua_gc(state, LUA_GCISRUNNING, 0) != 0);
+            else if (option == "step")
+                lua_pushboolean(state, lua_gc(state, LUA_GCSTEP, luaL_optinteger(state, 2, 0)) != 0);
+            else
+            {
+                int operation = LUA_GCCOLLECT;
+                if (option == "stop")
+                    operation = LUA_GCSTOP;
+                else if (option == "restart")
+                    operation = LUA_GCRESTART;
+                else if (option != "collect")
+                    luaL_error(state, "unsupported garbage collector option");
+                lua_pushinteger(state, lua_gc(state, operation, 0));
+            }
+            return 1;
+        }
+
+        // Narrow test result transport; no io/os library is introduced.
+        int harnessWriteAtomic(lua_State* state)
+        {
+            return invokeLuaCFunction(state, [&] {
+                size_t pathSize = 0;
+                const char* pathBytes = luaL_checklstring(state, 1, &pathSize);
+                const std::string_view path(pathBytes, pathSize);
+                if (path.empty() || path.find('\0') != std::string_view::npos)
+                    luaL_error(state, "result path must be nonempty and contain no NUL bytes");
+                size_t size = 0;
+                const char* bytes = luaL_checklstring(state, 2, &size);
+                const std::filesystem::path destination = Files::pathFromUnicodeString(path);
+                std::filesystem::path temporary = destination;
+                temporary += ".tmp";
+                try
+                {
+                    std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+                    if (!file)
+                        throw std::runtime_error("cannot open temporary performance result");
+                    file.write(bytes, static_cast<std::streamsize>(size));
+                    file.close();
+                    if (!file)
+                        throw std::runtime_error("cannot write temporary performance result");
+                    // A failed rename preserves any previously published result.
+                    std::filesystem::rename(temporary, destination);
+                }
+                catch (...)
+                {
+                    std::error_code ignored;
+                    std::filesystem::remove(temporary, ignored);
+                    throw;
+                }
+                lua_pushboolean(state, true);
+                return 1;
+            });
+        }
+
+        int harnessSandboxSelect(lua_State* state)
+        {
+            const int arguments = lua_gettop(state);
+            if (arguments == 1 && lua_type(state, 1) == LUA_TSTRING)
+            {
+                size_t length = 0;
+                const char* value = lua_tolstring(state, 1, &length);
+                if (std::string_view(value, length) == "sandbox.bypass")
+                {
+                    lua_pushvalue(state, lua_upvalueindex(2));
+                    return 1;
+                }
+            }
+            lua_pushvalue(state, lua_upvalueindex(1));
+            lua_insert(state, 1);
+            lua_call(state, arguments, LUA_MULTRET);
+            return lua_gettop(state);
+        }
+
+        void installHarnessAuthority(lua_State* state)
+        {
+            lua_getglobal(state, "select");
+            lua_createtable(state, 0, 2);
+            pushCFunction(state, harnessCollectGarbage, "openmw.internal.harnessCollectGarbage");
+            lua_setfield(state, -2, "collectgarbage");
+            pushCFunction(state, harnessWriteAtomic, "openmw.internal.harnessWriteAtomic");
+            lua_setfield(state, -2, "writeAtomic");
+            lua_setreadonly(state, -1, true);
+            pushCClosure(state, harnessSandboxSelect, "openmw.internal.harnessSandboxSelect", 2);
+            lua_setglobal(state, "select");
+        }
+
         constexpr std::string_view excludedSandboxGlobals[] = { "getfenv", "setfenv", "newproxy" };
         constexpr std::string_view replacedSandboxGlobals[] = { "getmetatable", "print", "require" };
         constexpr std::string_view internalSandboxGlobals[] = { "printGen", "requireGen", "getSafeMetatable" };
